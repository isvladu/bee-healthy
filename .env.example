# Bee Healthy — environment shape (no real secrets here).
#
# NOTE: The user's LLM API key is entered in-app and stored on-device (IndexedDB).
# It is NOT an environment variable and must never be committed.
#
# Vite exposes vars prefixed with VITE_ to the client bundle. Anything without
# that prefix is server-only and is read by the Vercel Functions in `api/`.

# ============================================================================
# SERVER-ONLY — never add a VITE_ prefix to anything in this section.
# A VITE_ variable is inlined into the browser bundle; the service-role key in
# the bundle is a full database compromise (it bypasses Row-Level Security).
# ============================================================================

# ---- Backend + database (self-managed auth, Workstream 2) ----
# Our Vercel Functions are the ONLY thing that talks to Supabase. The browser
# never holds a database credential. With these unset the whole server tier
# answers 503 and the app stays fully local-only.
#   SUPABASE_URL              — https://<project>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY — Project Settings → API → service_role (SECRET)
#   SESSION_SECRET            — random 32+ bytes, e.g. `openssl rand -base64 32`
#                               Peppers session/email token hashes. Rotating it
#                               signs everyone out; it does NOT affect passwords.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=

# Run supabase/migrations/*.sql in the SQL editor before first use.

# ---- Hosted AI on the owner's key (Workstream 3) ----
# Lets signed-in, email-verified users generate without bringing their own key.
# Unset = hosted AI is simply off; the app still works with a user's own key.
#
# THIS ONE COSTS MONEY DIRECTLY. Two controls bound it: a per-user credit
# balance (app_credits) and a hard monthly ceiling on total spend. Run
# supabase/migrations/0003_hosted_llm_credits.sql before enabling it.
#   ANTHROPIC_API_KEY — the OWNER's key. Server-only, obviously: a VITE_ prefix
#                       here would hand every visitor an unmetered key.
ANTHROPIC_API_KEY=

# Credits every account is topped up to on the 1st. One credit = one US cent of
# Anthropic list-price spend. Default 300 (= $3/user/month).
AI_FREE_MONTHLY_CREDITS=

# Hard ceiling on the owner's Anthropic spend per calendar month, in USD.
# Past it, hosted AI stops for everyone until the month rolls over; users with
# their own key are unaffected. Default 25.
AI_MONTHLY_BUDGET_USD=

# ---- Transactional email (verification + password reset) ----
# Optional: with these unset, signup still works and the account simply stays
# unverified. Resend needs a verified sending domain (SPF/DKIM/DMARC).
RESEND_API_KEY=
MAIL_FROM=

# Local development only. Prints verification/reset links to the console when
# no mail provider is configured. NEVER set this in production — it would put
# working credentials in your runtime logs.
MAIL_DEBUG=

# Public origin used to build links in outgoing email. Defaults to the Vercel
# deployment URL; set it for a custom domain.
APP_URL=

# Extra origins allowed to POST to /api (CSRF check). Vercel's own deployment
# URLs are allowed automatically; set this for a custom domain.
# e.g. https://beehealthy.app,https://www.beehealthy.app
APP_ALLOWED_ORIGINS=

# Legacy, /api/log only — APP_ALLOWED_ORIGINS now covers this too.
ERROR_LOG_ALLOWED_ORIGINS=

# ============================================================================
# CLIENT (VITE_) — public, non-secret values only.
# ============================================================================

# ---- Telemetry (/api/log) ----
# One switch for BOTH channels: error reports (reportError) and application
# events (logEvent). On in production builds, off under `vite dev`.
#   off = disable in production   |   on = enable in dev (to test `vercel dev`)
VITE_ERROR_REPORTING=
