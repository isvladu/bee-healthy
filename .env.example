# Bee Healthy — environment shape (no real secrets here).
#
# NOTE: The user's LLM API key is entered in-app and stored on-device (IndexedDB).
# It is NOT an environment variable and must never be committed.
#
# These are only needed once cloud sync (Supabase) is wired up in a later phase.
# Vite exposes vars prefixed with VITE_ to the client bundle — only put PUBLIC,
# non-secret values here (the Supabase anon key is safe to ship; RLS protects data).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Error reporting (/api/log) ----
# Client reporting is on in production builds and off under `vite dev`.
#   off = disable in production   |   on = enable in dev (to test `vercel dev`)
VITE_ERROR_REPORTING=

# SERVER-ONLY (no VITE_ prefix — never exposed to the browser).
# Extra origins allowed to POST to /api/log, comma-separated. Vercel's own
# deployment URLs are allowed automatically; set this for a custom domain.
# e.g. https://beehealthy.app,https://www.beehealthy.app
ERROR_LOG_ALLOWED_ORIGINS=
